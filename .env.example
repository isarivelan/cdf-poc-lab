# Copy to .env and fill values only on a trusted machine.
# Leave secrets empty for local demo mode. Never commit the filled file.

CDF_PROJECT=
CDF_CLUSTER=
CDF_BASE_URL=
CDF_TENANT_ID=
CDF_CLIENT_ID=
CDF_CLIENT_SECRET=
CDF_TOKEN_URL=
CDF_SCOPES=
CDF_DATA_SET_EXTERNAL_ID=cdf-maintenance-investigator-demo
CDF_SPACE=cdf_maintenance_demo
CDF_INSTANCE_SPACE=cdf_maintenance_demo_instances
CDF_ENVIRONMENT=dev

LOGIN_FLOW=client_credentials

APP_MODE=local
AI_PROVIDER=mock
AI_MODEL=
AI_ENDPOINT=
AI_API_KEY=
LOG_LEVEL=INFO

# Optional. Classic CDF events are not written unless this is true.
CDF_WRITE_CLASSIC_EVENTS=false

# Required only for scripts/cleanup_demo_resources.py. Never set this for a production project.
CDF_CONFIRM_CLEANUP=
